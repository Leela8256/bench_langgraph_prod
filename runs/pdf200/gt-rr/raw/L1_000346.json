fd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\t\t\t\t\ufffd\ufffd\ufffd\ufffd \ufffd\ufffd\ufffd\ufffd\r\r\r\r\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\t\t\t\t\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\t\t\t\t\n\n\n\n\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\t\t\t\t\n\n\ufffd\ufffd\ufffd\ufffd \ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\t\t\t\t\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\t\t\t\t\ufffd\ufffd\ufffd\ufffd        \ufffd\ufffd\ufffd\ufffd \t\t\t\t\n\t\t\t\t\n\nOn October 26, 2006, Inigo Varguez Felix, a Mexican citizen who \nadmittedly entered the United States illegally at least ten years ago, was \narrested in Orange Beach, AL by members of the U.S. Marshals Service \nGulf Coast Regional Fugitive Task Force assigned to Operation \nFALCON III.  Local authorities in the Southern District of Alabama \nwanted Felix for Sodomy and Sex Abuse of a Child Under 12 after he \nallegedly forced sex on a five year old boy.  The alleged abuse came to \nlight after the victim participated in a school class on \u201cgood touches & \nbad touches\u201d.  The victim, along with his two year old sister, often \nspent considerable time in Felix\u2019s presence, and provided investigators \nwith a complete, detailed description of sexual assaults which lasted for \nat least one year.  FALCON III investigators developed information on \n\nFelix\u2019s probable location at an Orange Beach, AL residence, responded to that site, and safely \ntook him into custody.  A search of the home incident to arrest yielded items corroborating the \nvictim\u2019s account of the alleged sexual abuses.", "type": "Document"}], "metadata": {"access_permission:assemble_document": "true", "access_permission:can_modify": "true", "access_permission:can_print": "true", "access_permission:can_print_faithful": "true", "access_permission:extract_content": "true", "access_permission:extract_for_accessibility": "true", "access_permission:fill_in_form": "true", "access_permission:modify_annotations": "true", "Content-Type": "application/pdf", "CreationDate--Text": "11/1/2006 15:39:42", "dc:creator": "U.S. Marshals Service", "dc:description": "Inigo Varguez Felix", "dc:format": "application/pdf; version=1.3", "dc:subject": "Inigo Varguez Felix", "dc:title": "FALCON 15 - Inigo Varguez Felix", "dcterms:created": "2006-11-01T15:39:42Z", "dcterms:modified": "2006-11-02T01:33:44Z", "pdf:containsDamagedFont": "false", "pdf:containsNonEmbeddedFont": "false", "pdf:hasCollection": "false", "pdf:hasMarkedContent": "false", "pdf:hasXFA": "false", "pdf:hasXMP": "true", "pdf:num3DAnnotations": "0", "pdf:ocrPageCount": "0", "pdf:overallPercentageUnmappedUnicodeChars": "0.24912525713443756", "pdf:PDFVersion": "1.3", "pdf:producer": "GNU Ghostscript 7.05", "pdf:totalUnmappedUnicodeChars": "356", "xmp:CreateDate": "2006-11-02T01:33:44Z", "xmp:CreatorTool": "PScript5.dll Version 5.2", "xmp:dc:creator": "U.S. Marshals Service", "xmp:dc:description": "Inigo Varguez Felix", "xmp:dc:title": "FALCON 15 - Inigo Varguez Felix", "xmp:MetadataDate": "2006-11-02T01:33:44Z", "xmp:ModifyDate": "2006-11-02T01:33:44Z", "xmp:pdf:Producer": "GNU Ghostscript 7.05", "xmpMM:DocumentID": "uuid:0d745aba-f71d-4872-b3c0-e8f9b71bb39e", "xmpTPg:NPages": "1"}, "name": "859b0dc8-3e7a-4c52-98ef-143eb44302c4", "path": "", "result_types": {"documents": "documents"}, "objectId": "f736eed4-6b56-518b-8a04-64717f3d1a41"}}]