# Copy to aws_run/local.env and fill in. local.env is git-ignored —
# this repo is public and AWS identifiers must never be committed.
BOX_INSTANCE=i-xxxxxxxxxxxxxxxxx   # the benchmark EC2 instance ID
BOX_PROFILE=leela                  # aws cli profile (SSO) — verified working 2026-08-14
BOX_REGION=us-east-1
# Discovered on day one (checklist 1.5) — bucket the instance role can write:
BENCH_BUCKET=
